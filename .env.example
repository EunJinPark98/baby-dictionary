# =============================================================================
# 아기별 지도 환경변수 — 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env.local
# =============================================================================

# Supabase 프로젝트 URL (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon(public) 키 또는 publishable 키. 브라우저에 노출되어도 되는 키입니다.
# (RLS 정책으로 데이터가 보호됩니다.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 서비스의 공개 URL (canonical / Open Graph / 이메일 인증 링크에 사용)
# 로컬: http://localhost:3000 · 배포: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (선택) 활성화할 소셜 로그인. Supabase Auth 에서 provider 설정 후 쉼표로 나열.
# 예: kakao,google  — 비워두면 이메일 로그인만 표시됩니다.
NEXT_PUBLIC_AUTH_PROVIDERS=

# ⚠️ service role key 는 이 앱에서 사용하지 않습니다.
#    절대로 NEXT_PUBLIC_ 접두사로 추가하거나 클라이언트 코드에서 사용하지 마세요.
